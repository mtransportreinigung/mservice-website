<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Offerte - Umzugsreinigung</title>
  <style>
    @page { size: A4; margin: 15mm; }
    body { font-family: Arial, sans-serif; font-size: 13px; color: #333; line-height: 1.4; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #0051C7; padding-bottom: 12px; margin-bottom: 20px; }
    .brand { font-size: 20px; font-weight: bold; color: #002266; }
    .subbrand { font-size: 11px; color: #666; margin-top: 2px; }
    .doc-title { text-align: right; }
    .doc-title h1 { font-size: 22px; color: #FF6A00; margin: 0; text-transform: uppercase; }
    .doc-title p { font-size: 12px; color: #555; font-weight: bold; }
    .two-col { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
    .box { flex: 1; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; }
    .box-title { font-size: 12px; font-weight: bold; color: #002266; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-bottom: 8px; text-transform: uppercase; }
    .form-row { margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between; }
    .form-row label { font-size: 11px; font-weight: bold; color: #475569; width: 40%; }
    input[type="text"], input[type="date"], select, textarea {
      width: 58%; padding: 4px 6px; border: 1px solid #94a3b8; border-radius: 4px; font-size: 12px; background: #fff;
    }
    textarea { width: 100%; height: 50px; resize: none; }
    .section-title { font-size: 13px; font-weight: bold; color: #002266; background: #e0f2fe; padding: 6px 10px; border-left: 4px solid #0051C7; margin: 15px 0 10px 0; text-transform: uppercase; }
    .price-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .price-table th, .price-table td { border: 1px solid #cbd5e1; padding: 8px; text-align: left; }
    .price-table th { background: #002266; color: #fff; font-size: 12px; }
    .total-box { margin-top: 15px; background: #fff7ed; border: 2px solid #FF6A00; padding: 12px; border-radius: 6px; text-align: right; }
    .total-title { font-size: 14px; font-weight: bold; color: #002266; }
    .total-amount { font-size: 20px; font-weight: bold; color: #FF6A00; }
    .footer { margin-top: 30px; border-top: 1px solid #cbd5e1; padding-top: 10px; font-size: 10px; color: #64748b; text-align: center; }
  </style>
</head>
<body>

  <div class="header">
    <div>
      <div class="brand">M Transport &amp; Reinigung Service</div>
      <div class="subbrand">Kanton Thurgau &amp; Umkreis | mservice.ch</div>
    </div>
    <div class="doc-title">
      <h1>OFFERTE</h1>
      <p>Umzugs- / Grundreinigung</p>
    </div>
  </div>

  <div class="two-col">
    <div class="box">
      <div class="box-title">Kundeninformationen</div>
      <div class="form-row"><label>Vor- &amp; Nachname:</label><input type="text" name="kunde_name"></div>
      <div class="form-row"><label>Telefon:</label><input type="text" name="kunde_telefon"></div>
      <div class="form-row"><label>E-Mail:</label><input type="text" name="kunde_email"></div>
      <div class="form-row"><label>Objekt Strasse/Nr:</label><input type="text" name="objekt_strasse"></div>
      <div class="form-row"><label>Objekt PLZ/Ort:</label><input type="text" name="objekt_ort"></div>
    </div>

    <div class="box">
      <div class="box-title">Auftragsdetails</div>
      <div class="form-row"><label>Offerten-Nr.:</label><input type="text" name="offerte_nr" value="OFF-2026-"></div>
      <div class="form-row"><label>Datum:</label><input type="text" name="offerte_datum"></div>
      <div class="form-row"><label>Reinigungstermin:</label><input type="text" name="reinigung_datum"></div>
      <div class="form-row"><label>Übergabetermin:</label><input type="text" name="uebergabe_datum"></div>
      <div class="form-row"><label>Garantie:</label><input type="text" name="garantie" value="Inkl. Abnahmegarantie"></div>
    </div>
  </div>

  <div class="section-title">Objektspezifikationen</div>
  <div class="two-col">
    <div class="box">
      <div class="form-row"><label>Objektart:</label><input type="text" name="objektart" placeholder="z. B. Wohnung"></div>
      <div class="form-row"><label>Anzahl Zimmer:</label><input type="text" name="zimmer" placeholder="z. B. 3.5"></div>
      <div class="form-row"><label>Wohnfläche (m²):</label><input type="text" name="flaeche"></div>
      <div class="form-row"><label>Möblierung:</label><input type="text" name="moebel" value="Unmöbliert / Leer"></div>
    </div>
    <div class="box">
      <div class="form-row"><label>Nasszellen (Bad/WC):</label><input type="text" name="nasszellen"></div>
      <div class="form-row"><label>Fenster / Storen:</label><input type="text" name="fenster"></div>
      <div class="form-row"><label>Nebennutzflächen:</label><input type="text" name="nebenflachen" placeholder="Balkon, Keller, etc."></div>
      <div class="form-row"><label>Besonderheiten:</label><input type="text" name="besonderheiten"></div>
    </div>
  </div>

  <div class="section-title">Leistungsbeschreibung &amp; Kostenberechnung</div>
  <table class="price-table">
    <thead>
      <tr>
        <th style="width: 60%;">Beschreibung der Dienstleistung</th>
        <th style="width: 15%;">Menge / Einheit</th>
        <th style="width: 25%;">Betrag (CHF)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Umzugsreinigung mit Abnahmegarantie</strong><br><small>Tiefenreinigung aller Räume, Nasszellen, Küche (inkl. Backofen/Geräte), Fenster &amp; Storen.</small></td>
        <td><input type="text" name="pos1_menge" value="Pauschal" style="width:90%;"></td>
        <td><input type="text" name="pos1_preis" placeholder="0.00 CHF" style="width:90%;"></td>
      </tr>
      <tr>
        <td>Zusatzleistungen (z. B. Balkonverglasung, Teppich-Sprühextraktion, Garagenreinigung)</td>
        <td><input type="text" name="pos2_menge" style="width:90%;"></td>
        <td><input type="text" name="pos2_preis" placeholder="0.00 CHF" style="width:90%;"></td>
      </tr>
    </tbody>
  </table>

  <div class="total-box">
    <span class="total-title">Gesamtbetrag (Pauschalpreis): </span>
    <input type="text" name="gesamtpreis" class="total-amount" placeholder="CHF 0.00" style="width: 200px; text-align: right;">
  </div>

  <div class="section-title">Anmerkungen &amp; Vereinbarungen</div>
  <textarea name="anmerkungen" placeholder="Hier zusätzliche Vereinbarungen eintragen..."></textarea>

  <div class="footer">
    M Transport &amp; Reinigung Service | Kanton Thurgau | E-Mail: info@mservice.ch | Tel: +41 78 345 80 72
  </div>

</body>
</html>
