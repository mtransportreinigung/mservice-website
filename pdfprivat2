<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Offerte - Unterhalts- &amp; Gebäudereinigung</title>
  <style>
    @page { size: A4; margin: 15mm; }
    body { font-family: Arial, sans-serif; font-size: 13px; color: #333; line-height: 1.4; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #002266; padding-bottom: 12px; margin-bottom: 20px; }
    .brand { font-size: 20px; font-weight: bold; color: #002266; }
    .subbrand { font-size: 11px; color: #666; margin-top: 2px; }
    .doc-title { text-align: right; }
    .doc-title h1 { font-size: 20px; color: #0051C7; margin: 0; text-transform: uppercase; }
    .doc-title p { font-size: 12px; color: #555; font-weight: bold; }
    .two-col { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
    .box { flex: 1; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; }
    .box-title { font-size: 12px; font-weight: bold; color: #002266; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-bottom: 8px; text-transform: uppercase; }
    .form-row { margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between; }
    .form-row label { font-size: 11px; font-weight: bold; color: #475569; width: 40%; }
    input[type="text"], input[type="date"], select, textarea {
      width: 58%; padding: 4px 6px; border: 1px solid #94a3b8; border-radius: 4px; font-size: 12px; background: #fff;
    }
    textarea { width: 100%; height: 50px; resize: none; }
    .section-title { font-size: 13px; font-weight: bold; color: #002266; background: #e0f2fe; padding: 6px 10px; border-left: 4px solid #0051C7; margin: 15px 0 10px 0; text-transform: uppercase; }
    .price-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .price-table th, .price-table td { border: 1px solid #cbd5e1; padding: 8px; text-align: left; }
    .price-table th { background: #002266; color: #fff; font-size: 12px; }
    .total-box { margin-top: 15px; background: #f0fdf4; border: 2px solid #16a34a; padding: 12px; border-radius: 6px; text-align: right; }
    .total-title { font-size: 14px; font-weight: bold; color: #002266; }
    .total-amount { font-size: 18px; font-weight: bold; color: #16a34a; }
    .footer { margin-top: 30px; border-top: 1px solid #cbd5e1; padding-top: 10px; font-size: 10px; color: #64748b; text-align: center; }
  </style>
</head>
<body>

  <div class="header">
    <div>
      <div class="brand">M Transport &amp; Reinigung Service</div>
      <div class="subbrand">Kanton Thurgau &amp; Umkreis | mservice.ch</div>
    </div>
    <div class="doc-title">
      <h1>OFFERTE</h1>
      <p>Unterhalts- / Gebäudereinigung</p>
    </div>
  </div>

  <div class="two-col">
    <div class="box">
      <div class="box-title">Auftraggeber</div>
      <div class="form-row"><label>Firma / Name:</label><input type="text" name="firma_name"></div>
      <div class="form-row"><label>Ansprechperson:</label><input type="text" name="ansprechperson"></div>
      <div class="form-row"><label>Telefon:</label><input type="text" name="telefon"></div>
      <div class="form-row"><label>E-Mail:</label><input type="text" name="email"></div>
      <div class="form-row"><label>Objektadresse:</label><input type="text" name="objekt_adresse"></div>
    </div>

    <div class="box">
      <div class="box-title">Vertragsdaten</div>
      <div class="form-row"><label>Offerten-Nr.:</label><input type="text" name="offerte_nr" value="OFF-2026-"></div>
      <div class="form-row"><label>Datum:</label><input type="text" name="offerte_datum"></div>
      <div class="form-row"><label>Gewünschter Start:</label><input type="text" name="start_datum"></div>
      <div class="form-row"><label>Reinigungsintervall:</label><input type="text" name="intervall" placeholder="z. B. 1x wöchentlich"></div>
      <div class="form-row"><label>Reinigungsmittel:</label><input type="text" name="mittel" value="Inklusive Service-Material"></div>
    </div>
  </div>

  <div class="section-title">Vereinbarter Leistungsumfang</div>
  <textarea name="leistungsumfang" style="height: 70px;" placeholder="Details zu den Aufgaben (z. B. Treppenhaus saugen &amp; feucht wischen, Fensterbänke reinigen, Sanitäranlagen desinfizieren, Mülleimer leeren...)"></textarea>

  <div class="section-title">Preiskalkulation</div>
  <table class="price-table">
    <thead>
      <tr>
        <th style="width: 55%;">Abrechnungsart</th>
        <th style="width: 20%;">Ansatz</th>
        <th style="width: 25%;">Kosten (CHF)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Regelmässige Reinigung</strong> (pro Einsatz / monatlich)</td>
        <td><input type="text" name="pos1_ansatz" placeholder="z. B. CHF 45.- / Std" style="width:90%;"></td>
        <td><input type="text" name="pos1_betrag" placeholder="0.00 CHF" style="width:90%;"></td>
      </tr>
      <tr>
        <td>Anfahrt &amp; Bereitstellung von Profi-Equipment</td>
        <td><input type="text" name="pos2_ansatz" value="Inbegriffen" style="width:90%;"></td>
        <td><input type="text" name="pos2_betrag" value="0.00 CHF" style="width:90%;"></td>
      </tr>
    </tbody>
  </table>

  <div class="total-box">
    <span class="total-title">Preis pro Reinigungseinsatz / Monat: </span>
    <input type="text" name="gesamtpreis" class="total-amount" placeholder="CHF 0.00" style="width: 180px; text-align: right;">
  </div>

  <div class="section-title">Kündigungsfristen &amp; Konditionen</div>
  <textarea name="konditionen" placeholder="z. B. Monatlich kündbar zum Monatsende. Zahlbar innert 10 Tagen nach Rechnungsstellung."></textarea>

  <div class="footer">
    M Transport &amp; Reinigung Service | Kanton Thurgau | E-Mail: info@mservice.ch | Tel: +41 78 345 80 72
  </div>

</body>
</html>
